# 이 파일은 커밋된다. 실제 값이 든 .env 는 커밋되지 않는다(.gitignore).
# 처음 받은 사람은 이 파일을 .env 로 복사해서 쓴다:
#   cp .env.example .env

# docker-compose.yml 의 db 서비스와 맞춘 값.
# 3307 = 내 PC 쪽 포트 (컨테이너 안은 3306)
DATABASE_URL="mysql://pt:ptpass@127.0.0.1:3307/issuetracker"

# ─────────────────────────────────────────────────────────────
# 아래는 **공개 데모를 띄울 때만** 쓴다 (docs/23). 사내 운영에는 하나도 필요 없다.
# 하나도 없으면 예전과 똑같이 — 도커 MySQL · 디스크 첨부 · 일반 로그인 화면 — 동작한다.
# ─────────────────────────────────────────────────────────────

# 로그인 화면에 데모 계정을 적어 둔다.
# ⚠️ 사내 운영에서 켜면 로그인 화면이 아이디·비밀번호를 그대로 광고한다.
# IT_DEMO=1

# 첨부파일을 디스크가 아니라 DB(file_blobs)에 담는다.
# 서버리스는 요청이 끝나면 디스크가 사라져서 storage/ 에 써도 다음 요청엔 없다.
# IT_STORAGE=db

# 업로드 상한(MB). 기본 10.
# Vercel 은 요청 본문 4.5MB 에서 플랫폼이 먼저 끊으므로 그보다 낮게 둔다.
# IT_MAX_UPLOAD_MB=4

# 관리형 MySQL(TiDB·Aiven 등)은 TLS 없이는 접속을 거부한다.
# IT_DB_SSL=1

# 서버리스는 인스턴스마다 커넥션 풀을 만든다. 안 줄이면 DB 접속 상한에 먼저 닿는다.
# IT_DB_POOL=3

# ─────────────────────────────────────────────────────────────
# 지라 보내기 (docs/11 14절 · docs/21). 하나도 안 주면 **미리보기까지만** 된다 —
# 고장이 아니다. 보낼 내용을 화면에서 확인할 수 있고, 지라에는 아무것도 만들어지지 않는다.
# ⚠️ 어디로 보내나(사이트·프로젝트·이슈 타입)는 여기가 아니라 **프로젝트 설정 화면**에 있다.
#    여기에는 «누구로 보내나» 만 둔다. DB 에 두면 백업 파일에 비밀이 실린다.
# ─────────────────────────────────────────────────────────────

# 연동 계정 — Atlassian 로그인 이메일과 API 토큰 (Basic 인증).
# 토큰 발급: https://id.atlassian.com/manage-profile/security/api-tokens
# IT_JIRA_EMAIL=someone@example.com
# IT_JIRA_TOKEN=...

# 지라 본문에 적을 **되돌아오는 링크**의 앞부분. 안 주면 링크 없이 이슈 번호만 적는다.
# 틀린 링크를 적는 것보다 낫다.
# IT_BASE_URL=http://192.168.0.10:3000
